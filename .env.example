# .env.example — local development defaults
# Copy to .env for local runs:
#   cp .env.example .env

# API
CARIB_CLEAR_API_KEY=
CARIB_CLEAR_ALLOWED_ORIGINS=
CARIB_CLEAR_TRUSTED_PROXY=
CARIB_CLEAR_ENV=local

# Admin / operator audit access
CARIB_CLEAR_ADMIN_TOKEN=
CARIB_CLEAR_COMPLIANCE_RELOAD_TOKEN=

# Database
CARIB_CLEAR_DATABASE_URL=sqlite:///carib_clear.db
CARIB_CLEAR_MIGRATION_DSN=sqlite:///carib_clear.db

# Broker
BROKER_ADAPTER=
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# Webhooks
CARIB_CLEAR_TEST_WEBHOOK_SECRET=
CARIB_CLEAR_WEBHOOK_TIMEOUT_SECONDS=10

# Optional secret backend
# CARIB_CLEAR_SECRET_BACKEND=vault
# CARIB_CLEAR_VAULT_URL=https://vault.example.com:8200
# CARIB_CLEAR_VAULT_TOKEN=...
# CARIB_CLEAR_VAULT_MOUNT=secret
# CARIB_CLEAR_VAULT_PREFIX=carib-clear

# Production durability
# In production, set CARIB_CLEAR_DATABASE_URL to a managed Postgres DSN:
#   postgres://<user>:<password>@<host>:5432/<db>?sslmode=require
# Do not leave SQLite as the production data path.
