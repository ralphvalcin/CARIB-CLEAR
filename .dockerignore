# Exclude everything by default
*

# Allow project source
!pyproject.toml
!README.md
!LICENSE
!carib_clear/
!tests/

# Exclude unnecessary within allowed dirs
**/__pycache__/
**/*.pyc
**/.DS_Store
**/*.db

# Exclude other projects
jarvis/
trading-system/
kreyol-ai/

# Exclude build artifacts
plans/
.hermes/
.git/
.gitignore
.github/
*.md
